# ============================================
# 心飞物流TMS 移动端 H5 镜像（pnpm workspace，driver/courier/customer 三端共用）
#
# uni-app 只有编译成 H5 才是网页，才能用 nginx 托管；
# 微信小程序 / App 端产物不走这个镜像（小程序在微信开发者工具上传，
# App 用 HBuilderX / uni-app CLI 打包）。
#
# 参数化：三端只改 build-arg，不需要新增 Dockerfile。
#
# 构建示例（司机端）：
#   docker build -f deploy/apps/Dockerfile.mobile-h5 \
#     --build-arg APP_PATH=xf-mobile \
#     --build-arg APP_SUBDIR=driver \
#     --build-arg APP_NAME=xf-mobile-driver \
#     -t xinfei/xf-driver-h5:<tag> .
#
# 为什么 Node 22 + pnpm 10：
#   uni-app 3.0 基于 Vite 5，要求 Node 18+；pnpm 10 与开发机构建版本(10.28)对齐，
#   避免 lockfile 主版本不兼容。
# ============================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS builder

RUN npm config set registry https://registry.npmmirror.com \
 && npm install -g pnpm@10 --registry=https://registry.npmmirror.com

# APP_PATH：移动端 monorepo 在仓库中的相对路径
ARG APP_PATH=xf-mobile
# APP_SUBDIR：目标端在 workspace 内的子目录（driver/courier/customer）
ARG APP_SUBDIR=driver
# APP_NAME：目标端包名（pnpm -F 过滤用）
ARG APP_NAME=xf-mobile-driver

WORKDIR /build

# 先拷 workspace 根清单 + 三个子包依赖清单，最大化复用层缓存：
# 业务代码变动但依赖不变时，直接命中 install 层，不重装
COPY ${APP_PATH}/package.json ./package.json
COPY ${APP_PATH}/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY ${APP_PATH}/pnpm-lock.yaml ./pnpm-lock.yaml
COPY ${APP_PATH}/.npmrc ./.npmrc
COPY ${APP_PATH}/driver/package.json ./driver/package.json
COPY ${APP_PATH}/courier/package.json ./courier/package.json
COPY ${APP_PATH}/customer/package.json ./customer/package.json
# 增加 fetch 重试参数：内网服务器对外 npm 源偶发 DNS/网络抖动（EAI_AGAIN）
# cache 固定 id=pnpm-mobile + sharing=locked：driver/courier/customer 三端同 lockfile 共享同一持久 store，
# 第一端装好后另两端直接命中；sharing=locked 保证并行构建写 store 串行安全。
# 配套要求清理只能 `docker builder prune -f`（不带 -a），-a 会把该 cache mount 一起清空
# 外层整命令重试 3 次（同 admin）：抵御整段 EAI_AGAIN，已下载包走共享 cache mount 不重下；
# --network-concurrency=8 降低瞬时 DNS 请求密度（默认 16 易在抖动窗口并发解析同时失败）。
RUN --mount=type=cache,id=pnpm-mobile,sharing=locked,target=/root/.local/share/pnpm/store \
    set -eu; \
    for i in 1 2 3; do \
      pnpm install --frozen-lockfile --network-concurrency=8 \
        --fetch-retries=5 --fetch-retry-factor=2 --fetch-retry-mintimeout=20000 --fetch-timeout=120000 && break; \
      echo ">>> pnpm install 第 $i 次失败（常见为外网 DNS 瞬态 EAI_AGAIN），10s 后重试，已下载包走 cache mount"; \
      [ "$i" = 3 ] && { echo ">>> pnpm install 连续 3 次失败，放弃构建"; exit 1; }; \
      sleep 10; \
    done

# 再拷整个 workspace 源码（node_modules 由 .dockerignore 排除）
COPY ${APP_PATH}/ ./

# 只构建目标端 H5（2026-10-11 移除早期排障用的 set -x / tee build.log / ls 诊断段，恢复正常构建）
RUN pnpm -F ${APP_NAME} run build:h5 \
 && test -f ${APP_SUBDIR}/dist/build/h5/index.html

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine

# APP_SUBDIR 需在运行阶段重新声明（ARG 默认不跨阶段传递）
ARG APP_SUBDIR=driver
# 复制构建产物（2026-10-10 修复：此前版本漏掉 COPY h5 产物，新镜像只剩 nginx 默认欢迎页）
COPY --from=builder /build/${APP_SUBDIR}/dist/build/h5/ /usr/share/nginx/html/

COPY deploy/apps/nginx/mobile-h5.conf /etc/nginx/templates/default.conf.template

ARG NGINX_HOST=192.168.20.130
ENV NGINX_HOST=${NGINX_HOST} \
    DOCKER_REQUEST_DOMAIN_PREFIX=http://xf-gateway:8760

EXPOSE 80
