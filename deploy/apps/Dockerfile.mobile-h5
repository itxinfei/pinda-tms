# ============================================
# 品达TMS uniapp 应用的 H5 版打包镜像（参数化，3 个 app 共用）
#
# uni-app 只有编译成 H5 才是网页，才能用 nginx 托管访问；
# 微信小程序 / App 端产物不走这个镜像（小程序要在微信开发者工具上传，
# App 要用 HBuilderX / uni-app CLI 云打包）。
#
# 参数化设计：另外 2 个 app 代码就位后，只改 compose 里的 build.args，
# 不需要新增 Dockerfile。
#
# 构建示例：
#   docker build -f deploy/apps/Dockerfile.mobile-h5 \
#     --build-arg APP_PATH=pd-mobile \
#     --build-arg BUILD_CMD=build:h5 \
#     --build-arg DIST_SUBDIR=build/h5 \
#     -t pinda/pd-driver-h5:<tag> .
#
# 为什么用 Node 22：
#   uni-app 3.0 (@dcloudio/uni-app 3.0.0-50206...) 基于 Vite 5，要求 Node 18+；
#   CI 旧作业镜像固定 Node 14，跑不了 Vite 5。
# ============================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS builder

RUN npm config set registry https://registry.npmmirror.com \
 && npm install -g pnpm@9 --registry=https://registry.npmmirror.com

# APP_PATH：uniapp 项目在仓库中的相对路径（默认 pd-mobile）
ARG APP_PATH=pd-mobile
# BUILD_CMD：package.json 里的构建脚本（uniapp H5 = build:h5）
ARG BUILD_CMD=build:h5
# DIST_SUBDIR：产物相对项目根的子目录（uniapp H5 输出到 build/h5）
ARG DIST_SUBDIR=build/h5

WORKDIR /build

# 依赖清单单独拷一层，最大化复用缓存
COPY ${APP_PATH}/package.json ${APP_PATH}/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# uni-app 需要 src/ 下的 pages.json / manifest.json，必须拷整个项目
COPY ${APP_PATH}/ ./

RUN pnpm run ${BUILD_CMD} \
 && test -f ${DIST_SUBDIR}/index.html \
 || (echo "=== 构建失败，产物目录内容如下 ==="; ls -laR ${DIST_SUBDIR} 2>/dev/null; echo "=== 项目根 ==="; ls -la; exit 1)

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine

COPY deploy/apps/nginx/mobile-h5.conf /etc/nginx/templates/default.conf.template

ENV NGINX_HOST=192.168.20.130 \
    DOCKER_REQUEST_DOMAIN_PREFIX=http://pd-gateway:8760

EXPOSE 80
