# ============================================
# 品达TMS 移动端 H5 镜像（pnpm workspace，driver/courier/customer 三端共用）
#
# uni-app 只有编译成 H5 才是网页，才能用 nginx 托管；
# 微信小程序 / App 端产物不走这个镜像（小程序在微信开发者工具上传，
# App 用 HBuilderX / uni-app CLI 打包）。
#
# 参数化：三端只改 build-arg，不需要新增 Dockerfile。
#
# 构建示例（司机端）：
#   docker build -f deploy/apps/Dockerfile.mobile-h5 \
#     --build-arg APP_PATH=pd-mobile \
#     --build-arg APP_SUBDIR=driver \
#     --build-arg APP_NAME=pd-mobile-driver \
#     -t pinda/pd-driver-h5:<tag> .
#
# 为什么 Node 22 + pnpm 10：
#   uni-app 3.0 基于 Vite 5，要求 Node 18+；pnpm 10 与开发机构建版本(10.28)对齐，
#   避免 lockfile 主版本不兼容。
# ============================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS builder

RUN npm config set registry https://registry.npmmirror.com \
 && npm install -g pnpm@10 --registry=https://registry.npmmirror.com

# APP_PATH：移动端 monorepo 在仓库中的相对路径
ARG APP_PATH=pd-mobile
# APP_SUBDIR：目标端在 workspace 内的子目录（driver/courier/customer）
ARG APP_SUBDIR=driver
# APP_NAME：目标端包名（pnpm -F 过滤用）
ARG APP_NAME=pd-mobile-driver

WORKDIR /build

# 先拷 workspace 根清单 + 三个子包依赖清单，最大化复用层缓存：
# 业务代码变动但依赖不变时，直接命中 install 层，不重装
COPY ${APP_PATH}/package.json ./package.json
COPY ${APP_PATH}/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY ${APP_PATH}/pnpm-lock.yaml ./pnpm-lock.yaml
COPY ${APP_PATH}/.npmrc ./.npmrc
COPY ${APP_PATH}/driver/package.json ./driver/package.json
COPY ${APP_PATH}/courier/package.json ./courier/package.json
COPY ${APP_PATH}/customer/package.json ./customer/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# 再拷整个 workspace 源码（node_modules 由 .dockerignore 排除）
COPY ${APP_PATH}/ ./

# 只构建目标端 H5
# [诊断版] set -x 暴露实际执行的命令与参数；build 输出落盘便于失败时回看；并先确认源码/COPY 是否就位。
# 定位到根因后需移除 set -x 与本段诊断回看，恢复为正常构建。
RUN set -x; \
    echo "APP_PATH=$APP_PATH APP_SUBDIR=$APP_SUBDIR APP_NAME=$APP_NAME"; \
    ls -la /build; \
    ls -la /build/${APP_SUBDIR}; \
    pnpm -F ${APP_NAME} run build:h5 2>&1 | tee /tmp/build.log; \
    test -f ${APP_SUBDIR}/dist/build/h5/index.html \
 || (echo "=== 构建失败！build.log 尾部 ==="; tail -50 /tmp/build.log; echo "=== ${APP_SUBDIR} 产物目录 ==="; ls -laR ${APP_SUBDIR}/dist 2>/dev/null; echo "=== workspace 根 ==="; ls -la; exit 1)

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine

# APP_SUBDIR 需在运行阶段重新声明（ARG 默认不跨阶段传递）
ARG APP_SUBDIR=driver
# 复制构建产物（2026-10-10 修复：此前版本漏掉 COPY h5 产物，新镜像只剩 nginx 默认欢迎页）
COPY --from=builder /build/${APP_SUBDIR}/dist/build/h5/ /usr/share/nginx/html/

COPY deploy/apps/nginx/mobile-h5.conf /etc/nginx/templates/default.conf.template

ENV NGINX_HOST=192.168.20.130 \
    DOCKER_REQUEST_DOMAIN_PREFIX=http://pd-gateway:8760

EXPOSE 80
