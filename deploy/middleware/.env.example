# 中间件环境变量模板 —— 只列键名，**值一律不入库**
#
# 用法（服务器）：
#   cp deploy/middleware/.env.example /data/deploy/middleware/.env
#   chmod 600 /data/deploy/middleware/.env   # 属主 root
#   然后填入真实口令，再 docker compose --env-file ... -f docker-compose.infra.yml up -d
#
# 为什么强制：docker-compose.infra.yml 用 ${VAR:?...} 取值，缺任一项 compose 直接报错，
# 不会静默起一个用默认口令的容器。口令的读取方（deploy/ci/*.sh、docs/06 §0）都指向这个文件。

# ---------- MySQL（容器 mysql8，宿主 3306） ----------
MYSQL_ROOT_PASSWORD=

# ---------- RabbitMQ（管理台 15672，tags: administrator） ----------
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
# 注意：轮换时**先改队列账号**（rabbitmqctl change_password），再改这里的值；
# 反序会在下次重建中间件时出现「新密码连旧库」。

# ---------- 不在本文件的应用级凭据（落点各不同，勿混填） ----------
# Nacos 口令        → **当前无处注入**：`deploy/apps/docker-compose.app.yml` 的 &nacos-env 只给
#                     NACOS_IP / NACOS_PORT / NACOS_ID / NACOS_SERVER_ADDR，没有 NACOS_PASSWORD；
#                     而 29 份 bootstrap-{dev,test,prod}.yml 写的是 `${NACOS_PASSWORD:pinda}`，
#                     所以线上（含 prod）实际生效值就是 yml 里那个明文默认值。修法见《凭据泄露处置方案.md》§7.4 第 4 条。
# Gitea 管理员口令  → 服务器 /etc/pinda-gitea-cred（root 0600），由 deploy/ci/deploy-info.sh 读取
# JWT 签名密钥对    → 服务器 /data/pinda-jwt/{pri,pub}.key，由 /data/ci/deploy.env 的
#                     PINDA_JWT_PRI_KEY_PATH / PINDA_JWT_PUB_KEY_PATH 指路（见《05-部署文档.md》§2.11）
# 短信 / 地图 Key    → /data/ci/deploy.env 的 SMS_ALIYUN_* / BAIDU_MAP_AK（当前 yml 里是空占位，未开通）
