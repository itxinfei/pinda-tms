# 中间件环境变量模板 —— 只列键名，**值一律不入库**
#
# 用法（服务器）：
#   cp deploy/middleware/.env.example /data/deploy/middleware/.env
#   chmod 600 /data/deploy/middleware/.env   # 属主 root
#   然后填入真实口令，再 docker compose --env-file ... -f docker-compose.infra.yml up -d
#
# 为什么强制：docker-compose.infra.yml 用 ${VAR:?...} 取值，缺任一项 compose 直接报错，
# 不会静默起一个用默认口令的容器。口令的读取方（deploy/ci/*.sh、docs/06 §0）都指向这个文件。

# ---------- MySQL（容器 mysql8，宿主 3306） ----------
MYSQL_ROOT_PASSWORD=

# ---------- RabbitMQ（管理台 15672，tags: administrator） ----------
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
# 注意：轮换时**先改队列账号**（rabbitmqctl change_password），再改这里的值；
# 反序会在下次重建中间件时出现「新密码连旧库」。

# ---------- Redis（宿主 6379，已启用 requirepass） ----------
# 2026-10-09 启用。消费方有两处，缺一即缓存失效：
#   1) 本文件 -> redis 容器 --requirepass
#   2) deploy/apps/.env 的 REDIS_PASSWORD -> apps compose 的 x-redis-env 锚点，
#      注入 SPRING_REDIS_PASSWORD（Spring RedisTemplate 用）
#      与 REDIS_PASSWORD（j2cache.properties 的 ${REDIS_PASSWORD:} 占位符用；
#        j2cache 直接解析 Properties 文件、不经 Spring Environment，
#        故 Nacos redis.yml 的 spring.redis.password 对 J2Cache L2 无效）
# 真实值也另存于服务器 /home/pdwl/redis-password.txt（0600）。
REDIS_PASSWORD=

# ---------- Nacos 服务端鉴权（2026-10-11 实际开启；密钥 2026-10-09 即已配置）----------
# 2026-10-09 只配齐了密钥但开关一直是 false（登录固定回 AUTH_DISABLED，等于裸奔）；
# 2026-10-11 置 true 并重建 nacos 生效：无 token 读写一律 403。
# 重建 nacos 容器时若缺这几项，鉴权会静默消失（任何人可读写配置）。
# NACOS_AUTH_TOKEN 是 JWT 签名密钥（Base64，解码后须 ≥32 字节）；改动它 = 已签发 token 全失效。
# NACOS_AUTH_IDENTITY_* 是 HTTP 请求头身份互认的 key/value，SERVER_IDENTITY_* 是 gRPC 侧同名对。
NACOS_AUTH_ENABLE=true
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_AUTH_SERVER_IDENTITY_KEY=
NACOS_AUTH_SERVER_IDENTITY_VALUE=

# ---------- 开发测试环境的口令取值约定 ----------
# 2026-10-09 经用户决策：192.168.20.130 这台内网开发测试机上，中间件口令**统一为 123456**，
# 目的是让开发和测试省掉一份"哪个库用哪个口令"的对照表。安全性由内网边界保证，
# 不做强口令要求（2026-10-09 之前 Redis/Nacos 曾分别用 24/20 位随机口令，已按此决策回退）。
#   MYSQL_ROOT_PASSWORD / RABBITMQ_DEFAULT_PASS / REDIS_PASSWORD = 123456
#   Nacos 超管 nacos 的口令 = 123456（2026-10-11 起全部微服务/CI 统一用此账号，
#     在 Nacos 内部用户表里，不在本文件；轮换用 POST /nacos/v1/auth/user/update，
#     参数是 password + newPassword）
#   另有命名空间级应用账号 xinfei/123456（仅 xinfei-tms 命名空间读写），保留备用，
#     生产收紧时微服务账号应从超管 nacos 切到 xinfei
# 生产环境**不适用本约定**，上线前必须逐套换掉，见《05-部署文档.md》与《凭据泄露处置方案.md》。

# ---------- 不在本文件的应用级凭据（落点各不同，勿混填） ----------
# 全量账号口令唯一权威表 → docs/需求文档/57-账号密码与凭据总表.md（docs 已 gitignore，不入库）
# Nacos 客户端账号  → 服务器 /data/xinfei-tms/deploy/apps/.env 的 NACOS_USERNAME / NACOS_PASSWORD
#                     （2026-10-11 起该文件已存在，nacos/123456，root 0600），由 apps compose 的
#                     &nacos-env 锚点注入。缺文件时 apps compose 的 ${VAR:?} 会直接报错。
# 应用侧 MySQL/Redis/RabbitMQ 口令 → 同一个 apps/.env（MYSQL_PASSWORD/REDIS_PASSWORD/RABBITMQ_*）
# Gitea 管理员口令  → 服务器 /etc/xinfei-gitea-cred（root 0600），内容 xinfei:xinfei123
#                     （Gitea 强制 8 位含字母数字，不用 123456），由 deploy/ci/deploy-info.sh 读取
# XXL-Job 控制台    → admin/123456（http://192.168.20.130:8090/xxl-job-admin）；
#                     executor accessToken（64 位随机串）在 /data/ci/apps.env 的 XXL_JOB_ACCESS_TOKEN
# CI 构建凭据       → /data/ci/apps.env（NACOS_USERNAME=nacos；NACOS/REDIS/MYSQL/RABBITMQ 口令=123456、
#                     RABBITMQ_USERNAME=xinfei、XXL token，0600；deploy-fe.sh 以 --env-file 加载它）
# JWT 签名密钥对    → 服务器 /data/xinfei-jwt/{pri,pub}.key（2026-10-11 实测目录为空，当前回落 jar 内密钥；
#                     上线前必须放置，见《05-部署文档.md》§2.11）
# 短信 / 地图 Key    → 真实第三方凭证禁止入库；百度地图 AK 走 -Dbaidu.map.ak / BAIDU_MAP_AK 部署注入，
#                     SMS_ALIYUN_* 当前未开通（yml 为空占位）
