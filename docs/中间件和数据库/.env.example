# ============================================
# 心飞物流TMS 中间件 .env —— 脱敏示例版
#
# 来源：192.168.20.130:/data/deploy/middleware/.env（2026-10-13 实机导出）
# 说明：真实口令保存在服务器该文件（root 0600，不入库）。本文件仅供还原编排
#       结构，所有口令值已脱敏为 ********。
# 注意：docker-compose.infra.yml 通过 ${VAR:?缺少 .env 里的 VAR} 强校验，
#       缺任一项 compose 直接报错，不会静默用默认口令启动。
# ============================================

MYSQL_ROOT_PASSWORD=********
RABBITMQ_DEFAULT_USER=xinfei
RABBITMQ_DEFAULT_PASS=********
NACOS_AUTH_IDENTITY_KEY=********
NACOS_AUTH_TOKEN=********
NACOS_AUTH_IDENTITY_VALUE=********
NACOS_AUTH_SERVER_IDENTITY_VALUE=********
NACOS_AUTH_ENABLE=true
NACOS_AUTH_SERVER_IDENTITY_KEY=serverIdentity
REDIS_PASSWORD=********
