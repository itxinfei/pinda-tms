NODE_ENV = production

# just a flag
ENV = 'docker'

VUE_APP_PROJECT_NAME = 'pinda'
# 开发环境请求域名前缀, 该变量仅仅开发环境需要设置
VUE_APP_DEV_REQUEST_DOMAIN_PREFIX = 'http://127.0.0.1:8080'
# 请求域名前缀， 该变量仅仅生产环境需要设置
VUE_APP_PROD_REQUEST_DOMAIN_PREFIX = ''
# URI 前缀，用于根据URI前缀进行代理
VUE_APP_BASE_API = '/api'
# 是否启用多租户（统一 false，当前为单租户，与 .env.production 一致）
VUE_APP_IS_MULTI_TENANT = false

# 修改点：OAuth2 客户端凭据（client_id:client_secret），由环境变量注入，禁止硬编码明文
VUE_APP_CLIENT_ID = 'febc'
VUE_APP_CLIENT_SECRET = '123456'

# 修改点：生产 Druid 监控地址由 CI/CD 注入（详见 .ci/build-frontend.sh），
# 仓库不固化生产 IP；本地构建可用未被 git 跟踪的 .env.docker.local 覆盖。
VUE_APP_DRUID_AUTHORITY_PROD = ''
VUE_APP_DRUID_FILE_PROD = ''

# 修复(2026-10-07): 禁止设置 VUE_CLI_BABEL_TRANSPILE_MODULES=true。
# 该变量会启用 babel-plugin-dynamic-import-node, 把 import() 预转成 require(纯变量),
# webpack 丢失 "@/views/" 静态前缀后只能生成空 context, 导致线上点菜单全部
# "Cannot find module '@/views/...'". 动态路由必须保留原生 import() 交给 webpack 解析。
