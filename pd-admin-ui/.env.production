# just a flag
ENV = 'production'

VUE_APP_PROJECT_NAME = 'pinda'
# 开发环境请求域名前缀， 该变量仅仅开发环境需要设置
VUE_APP_DEV_REQUEST_DOMAIN_PREFIX = 'http://localhost:8760'
# 请求域名前缀， 该变量仅仅生产环境需要设置
# VUE_APP_PROD_REQUEST_DOMAIN_PREFIX = 'http://115.29.150.110:8760'
VUE_APP_PROD_REQUEST_DOMAIN_PREFIX = 'http://39.100.244.120:8760'

# base api
VUE_APP_BASE_API = '/api'
# 是否启用多租户
VUE_APP_IS_MULTI_TENANT = false

# 修改点：OAuth2 客户端凭据（client_id:client_secret），由环境变量注入，禁止硬编码明文
VUE_APP_CLIENT_ID = 'febc'
VUE_APP_CLIENT_SECRET = '123456'

# 修改点：生产 Druid 监控地址由环境变量注入，禁止在源码硬编码 IP
VUE_APP_DRUID_AUTHORITY_PROD = 'http://39.100.244.120:8764/druid'
VUE_APP_DRUID_FILE_PROD = 'http://39.100.244.120:8765/druid'
