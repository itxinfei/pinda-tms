<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>pd-web</artifactId>
        <groupId>com.xinfei</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>pd-web-driver</artifactId>
    <name>pd-web-driver</name>
    <description>司机端聚合服务</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 项目内公共模块与服务契约 -->
        <dependency>
            <groupId>com.xinfei</groupId>
            <artifactId>pd-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xinfei</groupId>
            <artifactId>pd-service-auth-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.xinfei</groupId>
            <artifactId>pd-service-base-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xinfei</groupId>
            <artifactId>pd-service-work-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xinfei</groupId>
            <artifactId>pd-service-oms-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Nacos 注册/配置（版本由 Spring Cloud Alibaba BOM 托管） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- OpenFeign（版本由 Spring Cloud BOM 托管，移除旧 2.1.2 锁死） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Spring Cloud LoadBalancer：Cloud 2025 已移除 Ribbon，Feign 用 lb://服务名 调用必需（同 pd-web-manager） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Resilience4j 熔断降级（Feign Fallback 生效前提；版本由 Spring Cloud BOM 托管） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- Sa-Token：BFF 经 Feign 调 pd-auth /internal/** 时，InternalAuthRequestInterceptor
             需从同一 Redis 读取网关签发的 Same-Token；版本根 pom 统管，redis-jackson 传递 data-redis -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>

        <!-- springdoc-openapi 接口文档（替换 springfox） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
