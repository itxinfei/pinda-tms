<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xinfei</groupId>
    <artifactId>xinfei-tms</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>xfwl-common</module>
        <module>xfwl-base</module>
        <module>xfwl-oms</module>
        <module>xfwl-work</module>
        <module>xfwl-user</module>
        <module>xfwl-file-server</module>
        <module>xfwl-service-api</module>
        <module>xfwl-web</module>
        <module>xfwl-dispatch</module>
        <module>xfwl-aggregation</module>
        <module>xfwl-netty</module>
        <module>xfwl-gateway</module>
        <module>xfwl-auth</module>
    </modules>

    <properties>
        <!-- 编译目标：JDK 25 LTS（2026-10 升级；Spring Boot 4.1.1 要求 Java 17+，上限 Java 26，JDK25 完全兼容） -->
        <java.version>25</java.version>
        <!-- Spring Cloud 版本信息：Boot 4.1 配套线（2025.1.x，对应 Spring Cloud 2025.1.2） -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <!-- 鉴权：Sa-Token（本次拍板，替代 Shiro） -->
        <sa-token.version>1.46.0</sa-token.version>
        <!-- MyBatis-Plus -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- MyBatis-Spring（Spring Framework 7 兼容线；Boot4 强制需 4.0.0） -->
        <mybatis-spring.version>4.0.0</mybatis-spring.version>
        <!-- 算术/图形验证码（登录） -->
        <easy-captcha.version>1.6.2</easy-captcha.version>
        <!-- Excel 导入导出（用户等管理端，SYS#4） -->
        <easyexcel.version>3.3.4</easyexcel.version>
        <!-- ↓↓↓ 新栈第三方版本（Boot4 / jakarta） ↓↓↓ -->
        <!-- FastJSON2（替换 fastjson 1.2.x） -->
        <fastjson2.version>2.0.53</fastjson2.version>
        <!-- springdoc-openapi（替换 springfox）；Boot4/Spring7 需 3.x 大版本 -->
        <springdoc.version>3.1.1</springdoc.version>
        <swagger-core.version>2.2.22</swagger-core.version>
        <!-- Druid Spring Boot 4 starter（Boot4 专用，1.2.28 起提供 boot4-starter） -->
        <druid-boot4.version>1.2.28</druid-boot4.version>
        <!-- Google Guava（原由 seata-core 传递，移除 Seata 后显式声明；33.4 修复旧版 CVE） -->
        <guava.version>33.4.8-jre</guava.version>
        <!-- Commons IO（Spring Boot 3.x BOM 不再托管，需统一显式版本） -->
        <commons-io.version>2.17.0</commons-io.version>
        <!-- Drools（xfwl-oms 运费规则；8.38 为 8.x 最高、已 jakarta 化，纯 KIE API 编程式装配） -->
        <drools.version>8.38.0.Final</drools.version>
        <!-- HttpClient 4（xfwl-oms HttpRequestUtil 过渡使用，Boot4 BOM 已不托管；迁 5 需重写工具类） -->
        <httpclient.version>4.5.14</httpclient.version>
        <!-- MapStruct：编译期 DTO/Entity 映射，替代 BeanUtils.copyProperties（全栈 238 处，逐步迁移） -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Lombok（annotationProcessorPaths 引用；缺失会导致注解处理器不加载、全仓编译失败） -->
        <lombok.version>1.18.42</lombok.version>
        <!-- Lombok ↔ MapStruct 协作绑定（必须，保证 getter 先生成再被 MapStruct 读取） -->
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- ArchUnit：模块边界守护（test 作用域，红线"严禁跨模块写业务"可执行化）；
             1.4.1+ 携 ASM 9.8 支持 JDK25 class 文件版本 69（1.3.0 在 JDK25 下扫描为 0 类，规则空匹配） -->
        <archunit.version>1.4.2</archunit.version>
        <!-- ↓↓↓ SCA 供应链安全（T-SEC-E4：《72》依赖漏洞扫描；不绑 lifecycle，sca.yml 显式调 goal） ↓↓↓ -->
        <dependency-check.version>12.1.0</dependency-check.version>
        <cyclonedx.version>2.9.1</cyclonedx.version>
        <maven-enforcer.version>3.5.0</maven-enforcer.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud begin -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Gateway 在 Cloud 2025.1.x 中被拆到独立嵌套 BOM（spring-cloud-gateway-dependencies），
                 其版本管理不会随 spring-cloud-dependencies 一并传递给消费方，故需在此显式 import，
                 否则直接声明 spring-cloud-starter-gateway-server-webflux 会报"缺版本"。Boot4 线 gateway=5.0.2（旧 spring-cloud-starter-gateway 已拆为 -server-webflux / -server-webmvc）。 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-gateway-dependencies</artifactId>
                <version>5.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud end -->
            <!-- Spring Cloud Alibaba（Nacos 注册/配置） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Sa-Token（Servlet / WebMVC，Boot4 专用 starter） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token（响应式 / 网关 WebFlux，Boot4 专用 starter） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-reactor-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 会话/踢人 Redis 持久化（Jackson 3 序列化，Boot4 配套） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 核心件（SaSameUtil 等；供服务间 Feign 契约模块使用） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-core</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- EasyExcel：管理端 Excel 导入导出（SYS#4） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- MyBatis-Plus（与 Boot4 / Spring Framework 7 兼容；mybatis-spring 显式覆盖为 4.0.0，见下方） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Spring 4.0.0：支持 Spring Framework 7（Boot4 强制）；覆盖 MP starter 传递的 3.x -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <!-- MyBatis-Plus 扩展（MybatisPlusInterceptor / Page 等） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 核心（IdentifierGenerator 等；xfwl-common 以 optional 引入做 ID 适配） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 多租户/分页插件所需 JSqlParser -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 验证码（com.wf.captcha.*） -->
            <dependency>
                <groupId>com.github.whvcse</groupId>
                <artifactId>easy-captcha</artifactId>
                <version>${easy-captcha.version}</version>
            </dependency>

            <!-- ===== 新栈第三方坐标（Boot4 / jakarta） ===== -->
            <!-- FastJSON2 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <!-- springdoc-openapi（可启动 Web 服务） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- swagger v3 注解（纯 domain / common 库只需注解，不引 webmvc） -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>
            <!-- Druid Spring Boot 4 starter -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid-boot4.version}</version>
            </dependency>
            <!-- Google Guava（业务公共工具，版本显式托管） -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- Commons IO（Boot4 BOM 不托管，统一版本） -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>

            <!-- ===== R2：服务容错 + 开发效率 + 架构守护 ===== -->
            <!-- MapStruct（编译期映射，processor 版本与核心包一致） -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- ArchUnit JUnit5 集成（test 作用域；JUnit 版本由 Boot BOM 托管） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Lombok ↔ MapStruct 绑定（annotation processor 路径使用，无需普通依赖声明） -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>
            <!-- Resilience4j 版本由 Spring Cloud Circuit Breaker BOM 托管（2025.1 列车 = 5.0.x，托管 resilience4j 2.3.0 及其 spring 适配包），此处不声明 -->
            <!-- ⚠️ Jackson 3 的 java.time 支持已内建于 jackson-databind 3.x（tools.jackson.databind.ext.javatime.*），
                 独立模块 tools.jackson.datatype:jackson-datatype-jsr310 停止发版（Central 仅剩 3.0.0-rc1/rc2，无 GA），
                 故此处不声明该依赖；项目内 6 处引用（5 个 ConfigurationSupport + WebManagerApplication）的 import 已迁到 databind 内建包 -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 统一注解处理器：Lombok → MapStruct（一旦声明 paths，必须显式列出全部处理器） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!-- T-SEC-E4：OWASP Dependency-Check（CVE 比对）。不绑 lifecycle——常规编译/部署不跑
                     （NVD 拉取重、内网受限），由 .gitea/workflows/sca.yml 手动触发显式调用 check goal。
                     failOnError=false：NVD/镜像不可达时降级为告警而非构建失败，避免内网环境死锁。 -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <failOnError>false</failOnError>
                        <suppressionFiles>
                            <suppressionFile>${maven.multiModuleProjectDirectory}/ci/dependency-check-suppressions.xml</suppressionFile>
                        </suppressionFiles>
                        <formats>
                            <format>HTML</format>
                            <format>JSON</format>
                        </formats>
                    </configuration>
                </plugin>
                <!-- T-SEC-E4：CycloneDX SBOM（软件物料清单）。不绑 lifecycle，sca.yml 显式调
                     makeAggregateBom 聚合生成全仓 SBOM（target/bom.json），供漏洞比对与交付留档。 -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx.version}</version>
                    <configuration>
                        <projectType>application</projectType>
                        <schemaVersion>1.6</schemaVersion>
                        <outputFormat>json</outputFormat>
                    </configuration>
                </plugin>
                <!-- T-SEC-E4：Enforcer 禁依赖基线（log4j2 CVE-2021-44228 受害版本段 / fastjson 1.x 反序列化历史重灾区）。
                     仓库实际使用 fastjson2 与 Boot4 经 log4j-bom 托管的 log4j-api（无 core），预期恒绿；若未来引入即构建期当场红。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer.version}</version>
                    <configuration>
                        <fail>true</fail>
                        <rules>
                            <bannedDependencies>
                                <excludes>
                                    <exclude>org.apache.logging.log4j:log4j-core:[2.0,2.15.0)</exclude>
                                    <exclude>com.alibaba:fastjson:[0,1.2.83)</exclude>
                                </excludes>
                                <message>检测到被禁依赖（log4j-core 2.0~2.15 受 Log4Shell 影响 / fastjson 1.x&lt;1.2.83 存在反序列化历史漏洞），请勿引入；如确需，先走《60》技术栈评估并经安全确认。</message>
                            </bannedDependencies>
                        </rules>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Enforcer 进构建（继承全模块）：validate 阶段禁依赖基线，单模块构建/CI 全量构建均生效 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-vulnerable-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>