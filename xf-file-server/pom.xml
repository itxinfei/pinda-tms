<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<artifactId>xinfei-tms</artifactId>
		<groupId>com.xinfei</groupId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<groupId>com.xinfei</groupId>
	<artifactId>xf-file-server</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>xf-file-server</name>
	<description>文件服务：附件上传/查看（POD 签收照片等，D-07 链路）</description>

	<dependencies>
		<!-- 健康检查：/actuator/health 供 compose healthcheck HTTP 探活（本服务无库，仅进程级存活） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Sa-Token：Same-Token 入站校验（T-SEC-04）需经 starter 装配 Redis Dao，读取与 xf-auth
		     同一共享存储的令牌；spring-boot-starter-data-redis 由 sa-token-redis-template 传递引入 -->
		<dependency>
			<groupId>cn.dev33</groupId>
			<artifactId>sa-token-spring-boot4-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>cn.dev33</groupId>
			<artifactId>sa-token-redis-jackson</artifactId>
		</dependency>
		<!-- Nacos 注册/配置（版本由 Spring Cloud Alibaba BOM 托管） -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
		</dependency>
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
		</dependency>
		<!-- 有意不依赖 xf-common：同 xf-gateway，避免拖入数据源/MyBatis 栈（本服务无库）。
		     响应契约 {code,msg,data} 以《08》附录 A.1 为准，用 JDK record 直出。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
