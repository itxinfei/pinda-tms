                <version>${xf-service-user-api.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinfei</groupId>
                <artifactId>xf-service-aggregation-api</artifactId>
                <version>${xf-service-aggregation-api.version}</version>
