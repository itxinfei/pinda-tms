{
	"easycom": {
    "autoscan": true,
    "custom": {
    "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
    "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
    "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
	},
	"pages": [
		{
			"path": "pages/driver/home/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "心飞司机宝"
			}
		},
		{
			"path": "pages/driver/login/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/driver/task/wait",
			"style": {
				"navigationBarTitleText": "待提货",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/driver/task/onTheWay",
			"style": {
				"navigationBarTitleText": "在途任务"
			}
		},
		{
			"path": "pages/driver/task/history",
			"style": {
				"navigationBarTitleText": "历史任务",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/driver/task/detail",
			"style": {
				"navigationBarTitleText": "任务详情"
			}
		},
		{
			"path": "pages/driver/task/pickup",
			"style": {
				"navigationBarTitleText": "提货"
			}
		},
		{
			"path": "pages/driver/task/deliver",
			"style": {
				"navigationBarTitleText": "送达"
			}
		},
		{
			"path": "pages/driver/task/track",
			"style": {
				"navigationBarTitleText": "实时轨迹"
			}
		},
		{
			"path": "pages/driver/task/scan",
			"style": {
				"navigationBarTitleText": "扫码接单"
			}
		},
		{
			"path": "pages/driver/video/push",
			"style": {
				"navigationBarTitleText": "视频推流"
			}
		},
		{
			"path": "pages/driver/car/info",
			"style": {
				"navigationBarTitleText": "车辆信息"
			}
		},
		{
			"path": "pages/driver/profile/index",
			"style": {
				"navigationBarTitleText": "个人中心"
			}
		},
		{
			"path": "pages/driver/exception/report",
			"style": {
				"navigationBarTitleText": "异常上报"
			}
		}
	],
	"tabBar": {
		"color": "#86909C",
		"selectedColor": "#FF0033",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/driver/home/index",
				"text": "首页",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/home-active.png"
			},
			{
				"pagePath": "pages/driver/task/wait",
				"text": "任务",
				"iconPath": "static/tabbar/task.png",
				"selectedIconPath": "static/tabbar/task-active.png"
			},
			{
				"pagePath": "pages/driver/profile/index",
				"text": "我的",
				"iconPath": "static/tabbar/mine.png",
				"selectedIconPath": "static/tabbar/mine-active.png"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "心飞司机宝",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F5F7FA"
	},
	"condition": {
		"current": 0,
		"list": [
			{
				"name": "登录页",
				"pathName": "pages/driver/login/index"
			}
		]
	}
}
